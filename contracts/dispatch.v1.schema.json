{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://clouddispatch.example/contracts/dispatch.v1",
  "title":"Dispatch requested v1", "type":"object",
  "required":["version","eventId","orderId","destination","priority","amount"],
  "properties":{
    "version":{"const":1},"eventId":{"type":"string","format":"uuid"},"orderId":{"type":"string","format":"uuid"},
    "destination":{"type":"string","minLength":1,"maxLength":120},"priority":{"enum":["standard","express"]},
    "amount":{"type":"number","exclusiveMinimum":0,"maximum":1000000,"multipleOf":0.01}
  },
  "additionalProperties":true
}
